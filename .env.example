# ─────────────────────────────────────────────────────────────────────────────
# Distributed RAG Core — Environment Configuration
# Copy this file to .env and fill in your values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# ── LAN / HOST (one place for your machine IP) ───────────────────────────────
# Hostname or IPv4 where this stack is reachable from browsers and (for remote workers) from other PCs.
# Examples: localhost | 192.168.1.50 | 10.123.252.181
# Used by frontend (NEXT_PUBLIC_GATEWAY_URL) and docker-compose.worker.yml when scaling workers remotely.
PUBLIC_HOST=localhost

# Optional: full gateway URL for the browser (HTTPS or non-default port). If unset, defaults to http://${PUBLIC_HOST}:8000
# NEXT_PUBLIC_GATEWAY_URL=http://192.168.1.50:8000

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Google Gemini API key  (for Gemini Embedding 2)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONAL: LLM Providers ───────────────────────────────────────────────────

# Groq API key (recommended — fast free tier)
# Get one at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama URL — LLM + local vision (ingestion uses same URL for llava-style models)
# On Windows, use host.docker.internal to reach the host from containers
OLLAMA_URL=http://host.docker.internal:11434

# Vision model for images + sampled video frames (must be pulled in Ollama, e.g. ollama pull llava)
OLLAMA_VISION_MODEL=llava

# Video: max frames + spacing (seconds) for visual captions (Ollama and/or Gemini below)
VIDEO_VISUAL_MAX_FRAMES=6
VIDEO_VISUAL_INTERVAL_SEC=5

# Vision: try Ollama first, then Gemini if empty or Ollama missing. Set gemini_only if Ollama cannot run on this machine.
# ollama_then_gemini | gemini_only | ollama_only
VISION_ORDER=ollama_then_gemini

# Gemini model for image/video frame descriptions (generate_content, not embedding)
GEMINI_VISION_MODEL=gemini-2.0-flash

# Whisper model name for audio/video transcript timestamps (faster-whisper)
WHISPER_MODEL_SIZE=small

# ── OPTIONAL: Tuning ──────────────────────────────────────────────────────────

# Number of concurrent embedding workers (increase on machines with good CPUs)
WORKER_CONCURRENCY=2

# Secret key for gateway (change this in production)
SECRET_KEY=distributed-rag-secret-2025
